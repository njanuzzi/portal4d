VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ZeptoMail (envio do resultado do quiz por e-mail — api/quiz-result-email.ts)
# Cole o valor completo mostrado em SMTP/API > API > "Token de Enviar e-mail",
# incluindo o prefixo "Zoho-enczapikey " — o código usa esse valor direto no header Authorization.
ZEPTOMAIL_TOKEN=Zoho-enczapikey your-token-here
ZEPTOMAIL_FROM_EMAIL=contato@nubiajanuzzi.com
ZEPTOMAIL_FROM_NAME=Núbia Januzzi
